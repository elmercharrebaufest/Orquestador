<?xml version="1.0" encoding="utf-8"?>
<log4net>
  <appender name="NewRelicAppender" type="NewRelic.LogEnrichers.Log4Net.NewRelicAppender, NewRelic.LogEnrichers.Log4Net" >
    <threshold value="ALL"/>
    <appender-ref ref="FileAppender" />
  </appender>

  <appender name="FileAppender" type="log4net.Appender.FileAppender">
    <file value="C:\OrquestadorLogs/Orquestador.log.json" />
    <param name="AppendToFile" value="true" />
    <layout type="NewRelic.LogEnrichers.Log4Net.NewRelicLayout, NewRelic.LogEnrichers.Log4Net">
    </layout>
    <filter type="log4net.Filter.LevelRangeFilter">
      <acceptOnMatch value="true" />
      <levelMin value="WARN" />
      <levelMax value="FATAL" />
    </filter>
  </appender>

  <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="C:/OrquestadorLogs/Orquestador.log" />
    <appendToFile value="true" />
    <datePattern value="yyyyMMdd" />
    <rollingStyle value="Date" />
    <filter type="log4net.Filter.LevelRangeFilter">
      <acceptOnMatch value="true" />
      <levelMin value="DEBUG" />
      <levelMax value="FATAL" />
    </filter>
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%-5p %d %5rms %-22.22c{1} %-18.18M - %m%n" />
    </layout>
  </appender>

  <appender name="LogServidorInfo" type="log4net.Appender.RollingFileAppender">
    <file value="C:/OrquestadorLogs/OrquestadorInfo.log" />
    <appendToFile value="true" />
    <datePattern value="yyyyMMdd" />
    <rollingStyle value="Date" />
    <filter type="log4net.Filter.LevelRangeFilter">
      <acceptOnMatch value="true" />
      <levelMin value="INFO" />
      <levelMax value="INFO" />
    </filter>
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date - %message%newline" />
    </layout>
  </appender>

  <appender name="EventLogAppender" type="log4net.Appender.EventLogAppender" >
    <param name="LogName" value="SCATO" />
    <param name="ApplicationName" value="Orquestador - Servicio" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%-5p %d %5rms %-22.22c{1} %-18.18M - %m%n" />
    </layout>
    <filter type="log4net.Filter.LevelRangeFilter">
      <acceptOnMatch value="true" />
      <levelMin value="ERROR" />
      <levelMax value="FATAL" />
    </filter>
  </appender>

	<appender name="aiAppender" type="Microsoft.ApplicationInsights.Log4NetAppender.ApplicationInsightsAppender, Microsoft.ApplicationInsights.Log4NetAppender">
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%message%newline" />
		</layout>
		<!--<threshold value="DEBUG" />-->
		<filter type="log4net.Filter.LevelRangeFilter">
			<acceptOnMatch value="true" />
			<levelMin value="ERROR" />
			<levelMax value="FATAL" />
		</filter>
		<InstrumentationKey value="091ef476-bb61-4323-8326-ef67f37ce0a6" />
	</appender>

  <!--<logger name="LogInfo">
    <level value="INFO" />
    <appender-ref ref="LogServidorInfo" />
  </logger>-->
  
  <root>
    <level value="INFO" />
    <appender-ref ref="RollingLogFileAppender" />
    <appender-ref ref="EventLogAppender" />
	  <appender-ref ref="LogServidorInfo" />
	  <appender-ref ref="aiAppender" />
    <appender-ref ref="NewRelicAppender" />
  </root>
</log4net>
