<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.5" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  
	<PropertyGroup>
    
    <ExtensionTasksPath>$(MSBuildExtensionsPath)\ExtensionPack\4.0\</ExtensionTasksPath>
    <Reintentos>1</Reintentos>
    <PackageServidor>$(MSBuildProjectDirectory)\package</PackageServidor>

    <Exe>Molinos.Orquest.Servidor.exe</Exe>
    <OrquestadorService>SCATO - Orquestador de Dispositivos</OrquestadorService>

    <User>NT AUTHORITY\SYSTEM</User>
    <UserPassword></UserPassword>

    <DeployPath>D:\Orquestador</DeployPath>

  </PropertyGroup>
  
</Project>



