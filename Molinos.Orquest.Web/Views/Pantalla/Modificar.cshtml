@using Molinos.Orquest.Dominio.Recursos
@model Molinos.Orquest.Web.Models.ConfigPantallaModel
@{
    ViewBag.Title = Textos.Pantalla_Modificar;
    Layout = null;
}
@Scripts.Render("~/bundles/jqueryval")

@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Pantalla_Modificar }))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.Id)
    @Html.Partial("_CrearModificar", Model)           
}
