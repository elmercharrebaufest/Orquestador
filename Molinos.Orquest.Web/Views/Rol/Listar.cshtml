@using Molinos.Orquest.Dominio.Consultas
@using Molinos.Orquest.Dominio.Entidades
@using Molinos.Orquest.Dominio.Recursos
@using Molinos.Orquest.Dominio.Seguridad
@using Molinos.Orquest.Web.Helpers
@using System.Linq;

@{
    Layout = null;
    var items = (ListaPaginada<Rol>)ViewBag.Items;
}

<script src="~/Scripts/tooltipOnList.js" type="text/javascript"></script>
<style>
    .tip {
        max-width: 500px;
        white-space: normal;
    }
</style>

@Html.Grilla(items,
             grid => grid.Columns(
                grid.ColumnaEliminarModificar(Html, "Rol"),
                grid.Columna("Descripcion", Textos.Rol_NombreRol),
                grid.Column(header: Textos.Permisos_Titulo, format: ((item) =>
                    {
                        IEnumerable<RolPermisoOrquestador> rolPermisoOrquestador = ((ICollection<RolPermisoOrquestador>)item.PermisosAsociados);
                        return Html.Raw("<div class = 'ellipsis-overflow mostrar-lista'>" + Html.DisplayFor(m => rolPermisoOrquestador).ToHtmlString()
                                        + "<span class = 'tip'>" + Html.DisplayFor(m => rolPermisoOrquestador).ToHtmlString() + "</span>" + "</div>");
                    }))
                ))