                @Html.LabelFor(model => model.ComandoEstado)
                @Html.TextBoxFor(model => model.ComandoEstado, new { @class = "form-control", maxlength = 1 })
                @Html.ValidationMessageFor(model => model.ComandoEstado, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.RespuestaExito)
                @Html.TextBoxFor(model => model.RespuestaExito, new { @class = "form-control", maxlength = 1 })
                @Html.ValidationMessageFor(model => model.RespuestaExito, null, new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.Dispositivo.Activo)
                @Html.CheckBoxFor(m => m.Dispositivo.Activo, new { @checked = "checked" })
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.RespuestaError)
                @Html.TextBoxFor(model => model.RespuestaError, new { @class = "form-control", maxlength = 1 })
                @Html.ValidationMessageFor(model => model.RespuestaError, null, new { @class = "text-danger" })
            </div>
        </div>
    </div>
    @Html.Partial("_Configuracion", Model)
</div>
