        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.ComandoActivarSalida)
                @Html.TextBoxFor(model => model.ComandoActivarSalida, new { @class = "form-control" , maxlength = 1 })
                @Html.ValidationMessageFor(model => model.ComandoActivarSalida, null, new { @class = "text-danger" })
            </div>
        </div>
