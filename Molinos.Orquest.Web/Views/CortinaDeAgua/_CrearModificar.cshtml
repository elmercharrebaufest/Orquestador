@model Molinos.Orquest.Dominio.Entidades.ConfigCortinaAgua
<div class="container-fluid">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.Dispositivo.Codigo)
                @Html.TextBoxFor(model => model.Dispositivo.Codigo, new { @class = "form-control to-uppercase" })
                @Html.ValidationMessageFor(model => model.Dispositivo.Codigo, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.SenalDeActivacion)
                @Html.TextBoxFor(model => model.SenalDeActivacion, new { maxlength = 1, @class = "form-control" })
                @Html.ValidationMessageFor(model => model.SenalDeActivacion, null, new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.Dispositivo.Descripcion)
                @Html.TextBoxFor(model => model.Dispositivo.Descripcion, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Dispositivo.Descripcion, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.NumeroSalida)
                @Html.TextBoxFor(model => model.NumeroSalida, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.NumeroSalida, null, new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.DireccionDelVientoDesde)
                @Html.TextBoxFor(model => model.DireccionDelVientoDesde, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.DireccionDelVientoDesde, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.DireccionDelVientoHasta)
                @Html.TextBoxFor(model => model.DireccionDelVientoHasta, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.DireccionDelVientoHasta, null, new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.IntervaloPooling)
                @Html.TextBoxFor(model => model.IntervaloPooling, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.IntervaloPooling, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.Dispositivo.Activo)
                @Html.CheckBoxFor(m => m.Dispositivo.Activo)
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.TiempoActivacion)
                @Html.TextBoxFor(model => model.TiempoActivacion, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.TiempoActivacion, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.TiempoDeEsperaActivacion)
                @Html.TextBoxFor(model => model.TiempoDeEsperaActivacion, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.TiempoDeEsperaActivacion, null, new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="form-group">
                @Html.LabelFor(model => model.EstacionId)
                @Html.DropDownListFor(model => model.EstacionId, (IEnumerable<SelectListItem>)ViewBag.Estacion, "Ninguno", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.EstacionId, null, new { @class = "text-danger" })
            </div>
        </div> 
    </div>
    @Html.Partial("_Configuracion", Model)
</div>