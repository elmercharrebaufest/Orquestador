@model Molinos.Orquest.Dominio.Entidades.ConfigJsonToIotBox
    <div class="container-fluid">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.Dispositivo.Codigo)
                    @Html.TextBoxFor(model => model.Dispositivo.Codigo, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Dispositivo.Codigo, null, new { @class = "text-danger" })
                </div>
            </div>
           
        </div>
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.Dispositivo.Descripcion)
                    @Html.TextBoxFor(model => model.Dispositivo.Descripcion, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Dispositivo.Descripcion, null, new { @class = "text-danger" })
                </div>
            </div>
            
        </div>
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.NumeroSalida)
                    @Html.TextBoxFor(model => model.NumeroSalida, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.NumeroSalida, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.Dispositivo.Activo)
                    @Html.CheckBoxFor(m => m.Dispositivo.Activo)
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.Json_Id)
                    @Html.DropDownListFor(model => model.Json_Id, (IEnumerable<SelectListItem>)ViewBag.Sensores, "Ninguno", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Json_Id, null, new { @class = "text-danger" })
                </div>
            </div>

        </div>
        <div class="row">
            
        </div>
        @Html.Partial("_Configuracion", Model)
    </div>