@using Molinos.Orquest.Dominio.Recursos
@model Molinos.Orquest.Web.Models.FirmaModel

@{
    ViewBag.Title = Textos.Firma_Titulo;
    string resultadoOperacion = ViewBag.ResultadoOperacion;
}

@Scripts.Render("~/bundles/jqueryval")

<script src="~/scripts/firma.Modificar.js" type="text/javascript"></script>
<script src="~/scripts/bootstrap-filestyle.min.js" type="text/javascript"></script>

<div class="p-2 bd-highlight">
    <h2 class="h2">@Textos.Firma_Titulo</h2>
</div>
<div class="container">
    <div class="form-eventos">
        @using (Html.BeginForm("Index", "Firma", null, FormMethod.Post, new { enctype = "multipart/form-data", id = "datos-form", @class = "form" }))
        {
            <br />
            <div>
                <div>
                    @Html.LabelFor(model => model.Logo, new { @class = "control-label" })
                    @{
                        if (Model.Logo != null && Model.Logo.Count() > 0)
                        {
                            var base64 = Convert.ToBase64String(Model.Logo);
                            var imgSrc = String.Format("data:image/png;base64,{0}", base64);
                            <img alt="Cargar Imagen" src="@imgSrc" />
                        }
                    }
                </div>
            </div>
            <div>
                @Html.TextBoxFor(m => m.LogoFile, new { type = "file", name = "LogoFile", id = "logoBoton", @class = "control input-large " })
                @Html.ValidationMessageFor(model => model.LogoFile, null, new { @class = "text-danger" })
            </div>
            <div>
                <div>
                    @Html.LabelFor(model => model.Favicon, new { @class = "control-label" })
                    @{
                        if (Model.Favicon != null && Model.Favicon.Count() > 0)
                        {
                            var base64 = Convert.ToBase64String(Model.Favicon);
                            var imgSrc = String.Format("data:image/x-icon;base64,{0}", base64);
                            <img alt="Cargar Imagen" src="@imgSrc" />
                        }
                    }
                </div>
            </div>
            <div>
                @Html.TextBoxFor(m => m.FaviconFile, new { type = "file", name = "FaviconFile", id = "faviconBoton", @class = "" })
                @Html.ValidationMessageFor(model => model.FaviconFile, null, new { @class = "text-danger" })
            </div>
            @Html.ValidationSummary(true,null,new { @class="text-danger" })
            @Html.Hidden("resultadoExitosa", resultadoOperacion, new { @class = "resultadoExitosa" })
            @Html.HiddenFor(model => model.Id)
            @Html.HiddenFor(model => model.Logo)
            @Html.HiddenFor(model => model.Favicon)
            <br />
            <div>
                <button type="button" id="aceptar" class="btn btn-primary col-sm-12 col-md-5 ">
                    @Textos.Guardar
                </button>
                @Html.ActionLink(Textos.Cancelar, "Index", "Home", null, new { @class = "btn col-sm-12 col-md-5" })
            </div>
        }
    </div>
</div>