@using Molinos.Orquest.Dominio.Recursos
@model Molinos.Orquest.Dominio.Entidades.ConfigMeteorologica
@{
    ViewBag.Title = Textos.Meteorologica_Modificar;
    Layout = null;
}
@Scripts.Render("~/bundles/jqueryval")

@using (Ajax.BeginForm("Modificar", null, new AjaxOptions(), new { @class = "form-horizontal", data_dialogo_titulo = Textos.Meteorologica_Modificar}))
{
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.Id)
    @Html.Partial("_CrearModificar", Model)
}
