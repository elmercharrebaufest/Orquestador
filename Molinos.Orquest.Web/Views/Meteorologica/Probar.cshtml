@using Molinos.Orquest.Dominio.Recursos
@using Molinos.Orquest.Dominio.Dtos
@model Molinos.Orquest.Dominio.Entidades.ConfigMeteorologica

@{
    var titulo = Textos.PruebaMeteorologica_Diagnostico + ": " + Model.Dispositivo.Codigo;
    ViewBag.Title = titulo;
}
<script src="~/Scripts/pruebacamara.index.js"></script>
<div class="container content">
    <div class="row">
        <div class="h2">@titulo</div>
    </div>

    <div class="prueba-itc-area bg-light">
        <span class="prueba-itc-area-titulo">@Textos.ConfiguracionDispositivo</span>
        <div class="row datos-dispositivo">
            <div class="span5">
                <div class="row-fluid">
                    @Html.LabelFor(model => model.Dispositivo.Codigo)
                    @Html.DisplayFor(model => model.Dispositivo.Codigo)
                </div>
                <div class="row-fluid">
                    @Html.LabelFor(model => model.Dispositivo.Descripcion)
                    @Html.DisplayFor(model => model.Dispositivo.Descripcion)
                </div>
            </div>
            <div class="span5">
                <div class="row-fluid">
                    @Html.LabelFor(model => model.Dispositivo.Activo)
                    @Html.DisplayFor(model => model.Dispositivo.Activo)
                </div>
            </div>
            <div class="span10">
                <div class="row-fluid">
                    @Html.LabelFor(model => model.Ruta)
                    @Html.DisplayFor(model => model.Ruta)
                </div>
            </div>
        </div>
    </div>
    <div class="prueba-itc-area  bg-light">
        <span class="prueba-itc-area-titulo">@Textos.ObtenerImagen</span>
        <div class="row-fluid">

            <div class="span12">
                @if (ViewBag.Error != null)
                {
                    <div id="resultado-peso" class="span10 resultado-prueba">
                        @ViewBag.Error
                    </div>
                }
                else
                {
                    <div class="well">
                        <div id="myCarousel" class="carousel slide">
                            <!-- Carousel items -->
                            <div class="carousel-inner">
                                @{
                                    int count = 0;
                                    foreach (var grupo in (List<MeteorologicaDto>)ViewBag.Data)
                                    {
                                        string clase = "";
                                        if (count == 0)
                                        {
                                            clase = "active";
                                        }
                                        <div class="item @clase">
                                            <div class="row-fluid">
                                                @foreach (var imagen in grupo.Imagenes)
                                                {
                                                    <div class="span3"><a href="#x" class="thumbnail"><img src="data:image;base64,@System.Convert.ToBase64String(@imagen)" alt="Image" id="imagen-camara" class="imagen-camara" /></a></div>
                                                }
                                                <div class="span3" style="width: 240px;">
                                                    <table class="table table-striped table-bordered" style="width: 160px;">
                                                        <thead>
                                                            <tr>
                                                                <th>@grupo.Descripcion</th>
                                                            </tr>
                                                        </thead>
                                                        @if (grupo.Descripcion == "HUMEDAD" || grupo.Descripcion == "TEMPERATURA")
                                                        {
                                                            for (int i = 0; i < grupo.Detalle.Count; i += 3)
                                                            {

                                                                <tbody>
                                                                    <tr>
                                                                        <td>@grupo.Detalle[i]</td>

                                                                        <td>@grupo.Detalle[i + 1]</td>

                                                                        <td>@grupo.Detalle[i + 2]</td>
                                                                    </tr>
                                                                </tbody>

                                                            }
                                                        }
                                                        else if (grupo.Descripcion == "VIENTO" || grupo.Descripcion == "LLUVIA")
                                                        {
                                                            for (int i = 0; i < grupo.Detalle.Count; i += 2)
                                                            {

                                                                <tbody>
                                                                    <tr>
                                                                        <td>@grupo.Detalle[i]</td>
                                                                        <td>@grupo.Detalle[i + 1]</td>
                                                                    </tr>
                                                                </tbody>
                                                            }
                                                        }
                                                        else if (grupo.Descripcion == "SENSACION TERMICA")
                                                        {
                                                            for (int i = 0; i < grupo.Detalle.Count; i += 3)
                                                            {

                                                                <thead>
                                                                    <tr>
                                                                        <th>@grupo.Detalle[i]</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    <tr>
                                                                        <td>@grupo.Detalle[i + 1]</td>
                                                                        <td>@grupo.Detalle[i + 2]</td>
                                                                    </tr>
                                                                </tbody>
                                                            }
                                                        }
                                                        else
                                                        {

                                                            <tbody>
                                                                <tr>
                                                                    <td>@grupo.Detalle[0]</td>
                                                                    <td>@grupo.Detalle[1]</td>
                                                                </tr>
                                                            </tbody>
                                                        }
                                                    </table>
                                                </div>
                                            </div><!--/row-fluid-->
                                            </div><!--/item-->
                                        count++;
                                    }
                                }
                            </div><!--/carousel-inner-->
                            <a class="left carousel-control" href="#myCarousel" data-slide="prev">‹</a>
                            <a class="right carousel-control" href="#myCarousel" data-slide="next">›</a>
                        </div><!--/myCarousel-->
                    </div><!--/well-->
                }
            </div>
        </div>
    </div>
    <div class="span5">
        @Html.ValidationMessageFor(model => model.Ruta)
    </div>
        <div class="right margin">
            @Html.ActionLink(Textos.Volver, "Index", null, new { @class = "col-12 col-sm-2 btn btn-primary" })
        </div>
    </div>
