@using Molinos.Orquest.Dominio.Recursos
@model Molinos.Orquest.Web.Models.ConfigBalanzaPuertoModel

@{
    var titulo = Textos.PruebaBalanzaPuerto_Diagnostico + ": " + Model.Dispositivo.Codigo;
    ViewBag.Title = titulo;
 }
<script src="~/Scripts/pruebabalanzapuerto.index.js"></script>

<div class="container content">
    <div class="row-fluid">
        <div class="h2">@titulo</div>
    </div>

    <div class="prueba-itc-area">
        <span class="prueba-itc-area-titulo">@Textos.ConfiguracionDispositivo</span>
        <div class="row-fluid datos-dispositivo">
            <div class="span7">
                <div class="row-fluid">
                    @Html.LabelFor(model => model.Dispositivo.Codigo)
                    @Html.DisplayFor(model => model.Dispositivo.Codigo)
                </div>
                <div class="row-fluid">
                    @Html.LabelFor(model => model.Dispositivo.Descripcion)
                    @Html.DisplayFor(model => model.Dispositivo.Descripcion)
                </div>
                <div class="row-fluid">
                    @Html.LabelFor(model => model.DireccionIp)
                    @Html.DisplayFor(model => model.DireccionIp)
                </div>
                <div class="row-fluid">
                    @Html.LabelFor(model => model.Puerto)
                    @Html.DisplayFor(model => model.Puerto)
                </div>
            </div>
            <div class="span5">
                <div class="row-fluid">
                    @Html.LabelFor(model => model.ComandoConsulta)
                    @Html.DisplayFor(model => model.ComandoConsulta)
                </div>
                <div class="row-fluid">
                    @Html.LabelFor(model => model.TimeoutLectura)
                    @Html.DisplayFor(model => model.TimeoutLectura)
                </div>
                <div class="row-fluid">
                    @Html.LabelFor(model => model.Dispositivo.Activo)
                    @Html.DisplayFor(model => model.Dispositivo.Activo)
                </div>
            </div>
        </div>
    </div>
    <div class="prueba-itc-area bg-light">
        <span class="prueba-itc-area-titulo">@Textos.BalanzaPuerto_ComandoConsulta</span>
        <div class="row-fluid d-md-inline-flex mb-2 align-top pb-1 w-100">
            <div class="align-self-center col-lg-3">
                <a id="link-consulta" href="@Url.Action("ConsultaBalanzada", new {codigo = Model.Dispositivo.Codigo})" class="col-12 btn btn-outline-primary">@Textos.Iniciar</a>
                <input class="col-12" type="number" placeholder="@Textos.BalanzaPuerto_PruebaBalanzadaBorrado" id="idBalanzada" min="0" />
            </div>
            <div id="resultado-consulta" class="span10 resultado-prueba form-control" data-texto-carga="@Textos.Probando">
            </div>
        </div>
    </div>
    <div class="prueba-itc-area bg-light">
        <span class="prueba-itc-area-titulo">@Textos.BalanzaPuerto_ComandoConsultaPorRango</span>
        <div class="row-fluid d-md-inline-flex mb-2 align-top pb-1 w-100">
            <div class="align-self-center col-lg-3">
                <a id="link-consulta-por-rango" href="@Url.Action("ConsultaBalanzadaPorRango", new {codigo = Model.Dispositivo.Codigo })" class="col-12 btn btn-outline-primary">@Textos.Iniciar</a>
                <input class="col-12" type="number" min="0" id="idBalanzadaInicio" placeholder="@Textos.BalanzaPuerto_PruebaBalanzadaInicio" />
                <input class="col-12" type="number" min="0" id="idBalanzadaFin" placeholder="@Textos.BalanzaPuerto_PruebaBalanzadaFin" />
            </div>
            <div id="resultado-consulta-por-rango" class="span10 resultado-prueba form-control" data-texto-carga="@Textos.Probando">
            </div>
        </div>
    </div>
    <div class="prueba-itc-area bg-light">
        <span class="prueba-itc-area-titulo">@Textos.BalanzaPuerto_ComandoBorrado</span>
        <div class="row-fluid d-md-inline-flex mb-2 align-top pb-1 w-100">
            <div class="align-self-center col-lg-3">
                <a id="link-borrado" href="@Url.Action("BorradoBalanzada", new {codigo = Model.Dispositivo.Codigo })" class="col-12 btn btn-outline-primary">@Textos.Iniciar</a>
                <input class="col-12" type="number" min="0" id="idBalanzadaBorrado" name="idBalanzadaBorrado" placeholder="@Textos.BalanzaPuerto_PruebaBalanzadaBorrado" />
            </div>
            <div id="resultado-borrado" class="span10 resultado-prueba form-control" data-texto-carga="@Textos.Probando">
            </div>
        </div>
    </div>
    <div class="prueba-itc-area bg-light">
        <span class="prueba-itc-area-titulo">@Textos.BalanzaPuerto_ComandoConsultaPorRango</span>
        <div class="row-fluid d-md-inline-flex mb-2 align-top pb-1 w-100">
            <div class="align-self-center col-lg-3">
                <a id="link-borrado-por-rango" href="@Url.Action("BorradoBalanzadaPorRango", new {codigo = Model.Dispositivo.Codigo})" class="col-12 btn btn-outline-primary">@Textos.Iniciar</a>
                <input class="col-12" type="number" min="0" id="idBalanzadaBorradoInicio" placeholder="@Textos.BalanzaPuerto_PruebaBalanzadaInicio" />
                <input class="col-12" type="number" min="0" id="idBalanzadaBorradoFin" placeholder="@Textos.BalanzaPuerto_PruebaBalanzadaFin" />
            </div>
            <div id="resultado-borrado-por-rango" class="span10 resultado-prueba form-control" data-texto-carga="@Textos.Probando">
            </div>
        </div>
    </div>
    @Html.Action("Index", "PruebaConexion", new { ip = Model.DireccionIp, puerto = Model.Puerto })
    <div class="right margin">
        @Html.ActionLink(Textos.Volver, "Index", null, new { @class = "col-12 col-sm-2 btn btn-primary" })
    </div>
</div>