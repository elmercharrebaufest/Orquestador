@using Molinos.Orquest.Dominio.Recursos
@model Molinos.Orquest.Web.Models.ConfigPantallaPuestoDeViandaModel
    <div class="container-fluid">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.Dispositivo.Codigo)
                    @Html.TextBoxFor(model => model.Dispositivo.Codigo, new { @class = "form-control to-uppercase" })
                    @Html.ValidationMessageFor(model => model.Dispositivo.Codigo, null, new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.Dispositivo.Descripcion)
                    @Html.TextBoxFor(model => model.Dispositivo.Descripcion, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Dispositivo.Descripcion, null, new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m=>m.ConfigPuestoDeViandas)
                    @Html.DropDownListFor(m => m.ConfigPuestoDeViandas, new SelectList(ViewBag.Puestos, "Value", "Text"), "Seleccione Puesto", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.ConfigPuestoDeViandas, null, new { @class = "text-danger" })
                </div>
            </div>
        </div>
