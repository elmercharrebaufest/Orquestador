@using Molinos.Orquest.Dominio.Consultas
@using Molinos.Orquest.Dominio.Recursos
@using Molinos.Orquest.Dominio.Seguridad
@using Molinos.Orquest.Web.Helpers
@using Molinos.Orquest.Web.Models
@using Molinos.Orquest.Web.Seguridad

@{
    Layout = null;
    var items = (ListaPaginada<Molinos.Orquest.Dominio.Entidades.ConfigLectorQr>)ViewBag.Items;
}

@Html.Grilla(items,
    grilla => grilla.Columns(
    grilla.ColumnaEliminarModificar(Html, "LectorQr"),
    grilla.Columna("Dispositivo.Codigo", Textos.Codigo, c => c.Dispositivo.Codigo),
        grilla.Columna("Dispositivo.Descripcion", Textos.Descripcion, c => c.Dispositivo.Descripcion),
        grilla.Columna("ClaseDriver", Textos.Cabezal_ClaseDriver, x => x.ClaseDriver.Split('.', ',')[3]),
        grilla.Columna("Dispositivo.Concentrador.Codigo", Textos.Concentrador, x => x.Dispositivo.Concentrador != null ? x.Dispositivo.Concentrador.Codigo : ""),
        grilla.Columna("Lector", Textos.LectorTarjetas_Lector)))