@using Molinos.Orquest.Dominio.Recursos
@model Molinos.Orquest.Dominio.Entidades.ConfigSensor
@using Molinos.Orquest.Dominio

<script src="~/scripts/configuracion_sensor.js" type="text/javascript"></script>

<div id="camaras" class="row">
    <div class="col">
        <div class="form-group">
            <label>@Textos.Camara_Titulo_Modificar_Crear</label>
            @Html.DropDownListFor(model => model.CamaraId,
            (IEnumerable<SelectListItem>)ViewBag.Camaras, new { @class = "form-control" })
        </div>
    </div>
</div>

<div id="acciones" class="row">
    <div class="col">
        <div class="form-group">
            <label>@Textos.Acciones_Titulo_Modificar_Crear</label>
            @Html.DropDownListFor(model => model.Accion,
            (IEnumerable<SelectListItem>)ViewBag.Acciones, new { @class = "form-control" })
        </div>
    </div>
</div>