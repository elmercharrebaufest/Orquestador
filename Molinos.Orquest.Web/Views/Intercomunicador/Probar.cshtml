@using Molinos.Orquest.Dominio.Recursos
@using dtos = Molinos.Orquest.Dominio.Dtos
@model Molinos.Orquest.Web.Models.ConfigComunicadorModel

@{
    var titulo = Textos.Prueba_Comunicador + ": " + Model.Dispositivo.Codigo;
    ViewBag.Title = titulo;
}

<link href="~/Styles/area/shared/intercomunicadorDispositivo.css" rel="stylesheet" />

<script src="~/Scripts/pruebacabezal.index.js"></script>
<script src="~/Scripts/area/shared/intercomunicadorDispositivo.js"></script>
<div class="container content">
    <div class="row-fluid">
        <div class="h2">@titulo</div>
    </div>

    <div class="prueba-itc-area bg-light ">
        <span class="prueba-itc-area-titulo">@Textos.ConfiguracionDispositivo</span>
        <div class="row-fluid datos-dispositivo">
            <div class="span7">
                <div class="row-fluid">
                    @Html.LabelFor(model => model.Dispositivo.Codigo)
                    @Html.DisplayFor(model => model.Dispositivo.Codigo)
                </div>
                <div class="row-fluid">
                    @Html.LabelFor(model => model.Dispositivo.Descripcion)
                    @Html.DisplayFor(model => model.Dispositivo.Descripcion)
                </div>
                <div class="row-fluid">
                    @Html.LabelFor(model => model.NumeroSalida)
                    @Html.DisplayFor(model => model.NumeroSalida)
                </div>

            </div>
            <div class="span5">
                <div class="row-fluid">
                    @Html.LabelFor(model => model.Dispositivo.Activo)
                    @Html.DisplayFor(model => model.Dispositivo.Activo)
                </div>
            </div>
        </div>
    </div>
    @if (ViewBag.InterComunicadorDispositivo.Codigo != null)
    {
        <div class="prueba-itc-area bg-light">
            <span class="prueba-itc-area-titulo">Probar Intercomunicador</span>
            <div class="row-fluid">

                <div class="row-fluid">
                    @Html.Partial("~/Views/Shared/Intercomunicador/_Intercomunicador.cshtml")
                </div>
                <div class="row-fluid">
                    @Html.Partial("~/Views/Shared/Intercomunicador/_IntercomunicadorDispositivo.cshtml", (dtos.IntercomunicadorDispositivoDto)ViewBag.InterComunicadorDispositivo)
                </div>
                <!--<div class="align-self-center">-->
                @*<a id="link-peso" href="@Url.Action("ObtenerPeso", new {codigo = Model.Dispositivo.Codigo})" class="col-12 btn btn-outline-primary">@Textos.Iniciar</a>*@
                <!--</div>
                <div id="resultado-peso" class="span10 resultado-prueba form-control w-100" data-texto-carga="@Textos.Probando">
                </div>-->
            </div>
        </div>

    }
    @*Html.Action("Index", "PruebaConexion", new {ip = Model.DireccionIp, puerto = Model.Puerto})*@
        <div class="right margin">
            @Html.ActionLink(Textos.Volver, "Index", null, new { @class = "col-12 col-sm-2 btn btn-primary" })
        </div>
    </div>