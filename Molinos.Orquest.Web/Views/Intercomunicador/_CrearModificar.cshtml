@model Molinos.Orquest.Web.Models.ConfigComunicadorModel
<div class="container-fluid">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.Dispositivo.Codigo)
                @Html.TextBoxFor(model => model.Dispositivo.Codigo, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Dispositivo.Codigo, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.NumeroSalida)
                @Html.TextBoxFor(model => model.NumeroSalida, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.NumeroSalida, null, new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.Dispositivo.Descripcion)
                @Html.TextBoxFor(model => model.Dispositivo.Descripcion, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Dispositivo.Descripcion, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.PuertoDeAudio)
                @Html.TextBoxFor(model => model.PuertoDeAudio, new { @class = "form-control", @type = "number", @value = "0", @min = "1024", @max = "9999", @step = "1" })
                @Html.ValidationMessageFor(model => model.PuertoDeAudio, null, new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.TiempoMaximoEjecucion)
                @Html.TextBoxFor(model => model.TiempoMaximoEjecucion, new { @class = "form-control", @type = "number", @value = "0", @min = "0", @max = "9999999", @step = "1" })
                @Html.ValidationMessageFor(model => model.TiempoMaximoEjecucion, null, new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="form-group">
                @Html.LabelFor(model => model.Dispositivo.Activo)
                @Html.CheckBoxFor(m => m.Dispositivo.Activo, new { @checked = "checked" })
            </div>
        </div>
    </div>
    @Html.Partial("_Configuracion", Model)
    <div id="sensorDeEstadoContainer" data-grid-url="@Url.Action("ObtenerSensoresPorConcentrador")">
        @Html.Partial("_SensorDeEstado", Model)
    </div>
</div>

<script>
    $(function () {
        $("[name='Dispositivo.ConcentradorId']").change(function () {
            let container = $("#sensorDeEstadoContainer");
            let contradorId = this.value;
            let url = container.data().gridUrl + "?concentradorId=" + contradorId;

            $.get(url, function (data) {
                container.html(data);
            });
        });
    });
</script>