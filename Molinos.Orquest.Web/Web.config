    <add key="OrquestadorService" value="SCATO - Orquestador de Dispositivos" />
    <add key="UrlOrquestador" value="net.tcp://{0}:8081/ServicioOrquestador,http://{0}:8080/ServicioOrquestador" />
    <add key="HostServiciosWeb" value="bfdev258;bfdev260" />
	<add key="ICPCConfig" value="{&quot;iceServers&quot;: [{ &quot;urls&quot;: [&quot;stun:stun1.l.google.com:19302&quot;, &quot;stun:stun2.l.google.com:19305&quot;]}]}" />
	<add key="ICWebServerUrl" value="https://192.168.1.6:8889/rtc" />
	<add key="ICWSServerUrl" value="wss://192.168.1.6:8889/rtc" />
  </appSettings>
  <location path="FederationMetadata">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
